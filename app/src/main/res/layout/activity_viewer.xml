<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/fastScrollTrack"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <View
        android:id="@+id/fastScrollThumb"
        android:layout_width="6dp"
        android:layout_height="@dimen/fast_scroll_thumb_min"
        android:layout_gravity="end|top"
        android:layout_marginEnd="10dp"
        android:background="@drawable/scroll_thumb"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/page_pill_bg"
        android:elevation="3dp"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:minWidth="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/chromeHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:animateLayoutChanges="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/glass_margin"
        android:paddingEnd="@dimen/glass_margin">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_glass_panel"
            android:clipToOutline="true"
            android:elevation="@dimen/glass_elevation"
            android:outlineProvider="background"
            app:elevation="@dimen/glass_elevation"
            app:menu="@menu/viewer_menu"
            app:navigationContentDescription="@string/back"
            app:navigationIcon="@drawable/ic_back"
            app:titleTextAppearance="?attr/textAppearanceTitleMedium" />

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_panel"
            android:elevation="@dimen/glass_elevation"
            android:outlineProvider="background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_in_document"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1" />

            <TextView
                android:id="@+id/searchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/searchPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous_match"
                android:src="@drawable/ic_up" />

            <ImageButton
                android:id="@+id/searchNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next_match"
                android:src="@drawable/ic_down" />

            <ImageButton
                android:id="@+id/searchClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_search"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/saveProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:trackCornerRadius="2dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pageStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/glass_margin"
        android:layout_marginEnd="@dimen/glass_margin"
        android:layout_marginBottom="@dimen/glass_margin"
        android:background="@drawable/bg_glass_sheet"
        android:clipToOutline="true"
        android:clipToPadding="false"
        android:outlineProvider="background"
        android:contentDescription="@string/page_strip"
        android:elevation="@dimen/glass_elevation"
        android:orientation="horizontal"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</FrameLayout>
